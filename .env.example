# Porta da API
PORT=3000

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=projeto_backend

# Banco usado SOMENTE pelos testes (npm test). Nunca use o mesmo banco de desenvolvimento!
# Se omitido, usa "<DB_NAME>_test".
DB_NAME_TEST=projeto_backend_test
